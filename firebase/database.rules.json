{
  "rules": {
    ".read": false,
    ".write": false,

    "matches": {
      "$match_id": {
        ".read": true,

        "active_info": {
          ".read": true,
          ".write": true
        },

        "live_alert": {
          ".read": true,
          ".write": true
        },

        "live_action": {
          ".read": true,
          ".write": true
        },

        "metadata": {
          ".read": true,
          ".write": true
        },

        "push_queue": {
          ".read": true,
          ".write": true
        },

        "presence_summary": {
          ".read": true,
          ".write": true
        },

        "active_devices": {
          ".read": true,
          "$device_id": {
            ".read": true,
            ".write": true
          }
        }
      }
    },

    "admin_audit_log": {
      ".read": true,
      ".write": true
    }
  }
}
